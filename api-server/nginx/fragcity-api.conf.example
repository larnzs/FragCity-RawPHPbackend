# Independent virtual host for api.fragcity.ir.
# This is NOT the Pterodactyl Panel vhost.
# The sample assumes Debian PHP 8.3-FPM; verify the installed socket first.

server {
    listen 80;
    listen [::]:80;
    server_name api.fragcity.ir;

    root /var/www/fragcity-api/public;
    index index.php;
    client_max_body_size 32k;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
