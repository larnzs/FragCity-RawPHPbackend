# Example HTTP vhost for api.fragcity.ir.
# Keep this separate from the Pterodactyl Panel vhost.
# After DNS points api.fragcity.ir to this server and HTTP works, issue a TLS
# certificate with Certbot and use HTTPS for the shared-hosting client.

server {
    listen 80;
    listen [::]:80;
    server_name api.fragcity.ir;

    root /var/www/fragcity-api/public;
    index index.php;
    client_max_body_size 32k;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
