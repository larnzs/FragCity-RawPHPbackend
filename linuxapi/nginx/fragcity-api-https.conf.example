# Install only AFTER the api.fragcity.ir certificate exists.
# Keep the port-80 bootstrap vhost until Certbot has issued the certificate.

server {
    listen 80;
    listen [::]:80;
    server_name api.fragcity.ir;
    server_tokens off;

    # Keep this path available if using the webroot ACME challenge.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.fragcity.ir;

    root /var/www/fragcity-api/public;
    server_tokens off;
    client_max_body_size 32k;

    ssl_certificate /etc/letsencrypt/live/api.fragcity.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.fragcity.ir/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:FragCityAPI:10m;
    ssl_session_tickets off;

    location = /health {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_X_FRAGCITY_TIMESTAMP $http_x_fragcity_timestamp;
        fastcgi_param HTTP_X_FRAGCITY_NONCE $http_x_fragcity_nonce;
        fastcgi_param HTTP_X_FRAGCITY_SIGNATURE $http_x_fragcity_signature;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Legacy Agent endpoints terminate in the Linux API gateway, which proxies
    # signed HTTPS requests to the shared-host website connector. No site MySQL is
    # exposed to this server. PHP still routes only to the fixed index.php script.
    location ^~ /v1/agent/ {
        client_max_body_size 64k;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_X_FRAGCITY_TIMESTAMP $http_x_fragcity_timestamp;
        fastcgi_param HTTP_X_FRAGCITY_NONCE $http_x_fragcity_nonce;
        fastcgi_param HTTP_X_FRAGCITY_SIGNATURE $http_x_fragcity_signature;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_X_AGENT_SECRET $http_x_agent_secret;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /v1/weaponpaints {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_X_FRAGCITY_TIMESTAMP $http_x_fragcity_timestamp;
        fastcgi_param HTTP_X_FRAGCITY_NONCE $http_x_fragcity_nonce;
        fastcgi_param HTTP_X_FRAGCITY_SIGNATURE $http_x_fragcity_signature;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /v1/server-browser {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_X_FRAGCITY_TIMESTAMP $http_x_fragcity_timestamp;
        fastcgi_param HTTP_X_FRAGCITY_NONCE $http_x_fragcity_nonce;
        fastcgi_param HTTP_X_FRAGCITY_SIGNATURE $http_x_fragcity_signature;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location / {
        return 404;
    }

    location ~ \.php$ {
        return 404;
    }
}
