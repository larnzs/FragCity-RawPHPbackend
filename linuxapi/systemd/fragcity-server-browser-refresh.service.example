[Unit]
Description=Refresh FragCity public CS2 Server Browser cache
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/fragcity-api
ExecStart=/usr/bin/php /var/www/fragcity-api/bin/refresh-server-browser.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/fragcity-api
