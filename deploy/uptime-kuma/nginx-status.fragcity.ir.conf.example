# Uptime Kuma reverse proxy example.
# Install in the Nginx http context (for example /etc/nginx/conf.d/).
# Keep Docker bound to 127.0.0.1:3001; do not expose port 3001 publicly.

server {
    listen 80;
    listen [::]:80;
    server_name status.fragcity.ir;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name status.fragcity.ir;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/status.fragcity.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/status.fragcity.ir/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:FragCityKuma:10m;
    ssl_session_tickets off;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }
}
